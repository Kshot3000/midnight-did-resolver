# Build the current Ledger9 source locally; older published service RCs use Ledger8.
RESOLVER_IMAGE=midnight-did-resolver:ledger9-local
MANAGER_IMAGE=midnight-did-manager:ledger9-local

# Host ports for the two applications.
RESOLVER_PORT=3001
MANAGER_PORT=3010

# Manager state is persisted on the host between demo runs.
MANAGER_DATA_DIR=${HOME}/.midnight-did/manager

# Optional overrides for the local Midnight infrastructure.
PROOF_SERVER_IMAGE=midnightntwrk/proof-server:9.0.1
INDEXER_IMAGE=midnightntwrk/indexer-standalone:4.4.101
NODE_IMAGE=midnightntwrk/midnight-node:2.1.101
